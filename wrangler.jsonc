/*
 * Cloudflare Workers config.
 *
 * The site is static assets in ./public. The Worker exists only to proxy
 * StuntListing's GraphQL API same-origin, because that API sends no CORS
 * headers — see src/worker.js. Static files are served without the Worker
 * running at all.
 *
 * Deploy with:  npx wrangler deploy
 * Local dev:    npx wrangler dev
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hairselfie",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  /*
   * Where finished sheets are kept. Object storage, not a database: a sheet
   * is a JPEG, and everything anyone needs to find one again — whose it is,
   * what kind, when — fits in the object's own key and metadata. R2 lists
   * by prefix, so "every sheet belonging to user 33" is a listing, not a
   * query. See src/worker.js.
   */
  /*
   * Who can see the admin page. Checked against the email on the signed-in
   * profile, server-side — the same list the rate calculator uses.
   */
  "vars": {
    "ADMIN_EMAILS": "james.northrup@gmail.com,jamie@stuntlisting.com,warrenhullstunts@gmail.com,warren.hull.stunts@gmail.com,warren@stuntlisting.com,greg@stuntlisting.com,info@stuntlisting.com,thestuntassistant@gmail.com,derric@stuntlisting.com"
  },

  "r2_buckets": [
    { "binding": "SHEETS", "bucket_name": "hairselfie-sheets" }
  ]
}
